# Dev-serverda /api so'rovlari shu manzilga proxy qilinadi (PHP backend joylashgan joy).
# Masalan lokal cPanel/XAMPP: http://localhost yoki http://maker-bot.local
VITE_API_PROXY_TARGET=http://localhost

# PRODUCTION uchun (Vercel va h.k.): agar frontend backend bilan BOSHQA
# domenda joylashtirilsa, shu yerga backend manzilini yozing. Vercel
# dashboardida Project Settings -> Environment Variables bo'limiga
# xuddi shu nom bilan qo'shiladi (bu faylga emas — bu fayl faqat namuna).
VITE_API_BASE_URL=https://domeningiz.uz

# Google orqali kirish/ro'yxatdan o'tish tugmasi uchun (Google Cloud Console
# -> APIs & Services -> Credentials -> OAuth client ID -> Web application).
# Backenddagi (.env) GOOGLE_CLIENT_ID bilan AYNAN bir xil bo'lishi shart.
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
